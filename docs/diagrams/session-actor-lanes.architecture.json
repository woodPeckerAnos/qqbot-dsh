  "cards": [
    {
      "dot": "violet",
      "title": "lane 进程隔离",
      "items": [
        "每个 (Session, lane, Task) 取独占 runtime 租约：一个 dsh 子进程，不是线程",
        "fast / slow 各一个 RuntimePool，上限 fastRuntimes / slowRuntimes 独立计算",
        "模型与 provider 按 lane 绑定，fast 额外 reasoningEffort=off",
        "每次执行唯一 sessionId + runtimeGeneration，迟到事件按三元组丢弃"
      ]
    },
    {
      "dot": "cyan",
      "title": "短事务与输入顺序",
      "items": [
        "同一 Session 的输入判定与提交串行，执行与发送不进门闩（session-actor.ts）",
        "generation 与回放边界写入 task-sessions.json，重启后 /new 与自动换话题仍生效",
        "主动提交在等门闩之前固定触发窗口与 generation，不随后来的输入改写"
      ]
    },
    {
      "dot": "emerald",
      "title": "状态所有权",
      "items": [
        "TaskLifeCycleManager 唯一写 Task 状态；MessageQueue 唯一写投递状态",
        "双 lane 都终结才结算 Task：取消优先，否则任一失败为 failed，其余 completed",
        "执行结束不等待投递；投递失败只记投递终态，不改写执行状态"
      ]
    },
    {
      "dot": "amber",
      "title": "取消与恢复",
      "items": [
        "/stop 只取消命令到达时正在执行的 Task；/new 取消全部未完成 Task 并推进 generation",
        "取消先记 cancelAccepted，再由 Actor 终止调度；已入队产物继续投递",
        "重启不重跑执行：未完成 lane 记为中断失败，sending 消息标失败并补一次通知"
      ]
    },
    {
      "dot": "rose",
      "title": "上下文与产物",
      "items": [
        "PromptPreparer 每次输入固定窗口与回放，每个 Task 的 prepare 只摄取一次",
        "附件先复制到队列目录，Task 工作区到期清理后仍能发送",
        "存活提醒最多一次；没有合法出口时直接放弃"
      ]
    }
  ]
