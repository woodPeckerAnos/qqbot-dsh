# ============================================================================
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实密钥。
# ============================================================================

# --- 接入平台选择 ------------------------------------------------------------
# 启用哪些接入层，逗号分隔，可并存（共享同一个 DSH 池与编排层）：
#   qq-official  官方开放平台（api.bot.qq.com），需要审核通过的机器人
#   onebot       社区框架（NapCat / LLOneBot / Lagrange 等 OneBot v11 实现），
#                本服务起 WS server、框架连入（反向 WebSocket），无需审核
# 默认 qq-official。两个都启用：BOT_CONNECTORS=qq-official,onebot
BOT_CONNECTORS=qq-official

# --- QQ 机器人开放平台（BOT_CONNECTORS 含 qq-official 时必填）------------------
# 获取位置：https://q.qq.com/qqbot/  → 开发设置
QQ_APP_ID=
QQ_APP_SECRET=

# --- DeepSeek（必填）-------------------------------------------------------
DEEPSEEK_API_KEY=

# --- OneBot v11 社区框架（BOT_CONNECTORS 含 onebot 时必填 access token）-------
# 本服务以反向 WS 方式接入：这里监听端口，LLBot/NapCat 作为客户端连入。
# 框架侧配置（LLBot：WebUI → OneBot 11 → 反向 WS）：
#   URL: ws://127.0.0.1:6700/onebot/v11/ws    Token: 与下面一致
# ⚠ token 必填且要够长够随机：没有它，任何能连上端口的人都能驱动 agent。
#
# ⚠⚠ ONEBOT_WS_HOST 必须保持 0.0.0.0（默认值），不要改成 127.0.0.1。
#   框架原生跑在宿主、本服务在 Docker 时，宿主的 127.0.0.1:6700 是 Docker 的
#   端口转发，它落到**容器网卡**上；容器里若只绑 loopback，转发就够不到，
#   表现为"端口映射正常但就是连不上"。只有"框架与本服务在同一个容器网络里"
#   或"两者都裸机跑"时，绑 127.0.0.1 才有意义。
ONEBOT_WS_HOST=0.0.0.0
ONEBOT_WS_PORT=6700
ONEBOT_ACCESS_TOKEN=
# 是否响应私聊消息（false = 只服务群聊）
ONEBOT_C2C_ENABLED=true
# 收到加好友请求时自动同意（默认 true：否则私聊路径永远打不开）
ONEBOT_AUTO_ACCEPT_FRIEND=true
# 收到拉群邀请时自动同意（默认 false：被拉进陌生群等于把 agent 暴露给陌生人）
ONEBOT_AUTO_ACCEPT_GROUP_INVITE=false
# OneBot 侧行为参数：无被动回复窗口、无平台级回复配额，
# 所以单轮超时可以更宽（默认 10 分钟），配额只是防失控的安全阀
ONEBOT_TURN_TIMEOUT_MS=600000
ONEBOT_MAX_CHARS=1500
ONEBOT_MAX_REPLIES_PER_MSG=10
ONEBOT_PROGRESS_MAX=3
ONEBOT_PROGRESS_AFTER_MS=90000
ONEBOT_PROGRESS_INTERVAL_MS=90000

# --- QQ 事件接入 -----------------------------------------------------------
# 事件接收方式在 QQ 开放平台控制台切换（WebSocket ↔ Webhook），本 MVP 只实现
# WebSocket 长连接，控制台里请选择「WebSocket」。
QQ_API_BASE=https://api.bot.qq.com
# 订阅的 intents 位掩码。默认 = GROUP_AND_C2C_EVENT(1<<25) + GROUP_MEMBER_EVENT(1<<24)
# 注意：1<<25 同时承载群聊 @消息与单聊消息，intent 层无法只订其中一种。
# 如果连接被 4014（intent 无权限）拒绝，把这行改成 33554432 再试。
QQ_INTENTS=50331648

# --- 单聊（C2C）------------------------------------------------------------
# 是否响应私聊消息。false = 只服务群聊（对方发来的私聊会被静默忽略）。
# 因为 1<<25 无法只订群聊，要"只服务群聊"必须靠这个开关。
QQ_C2C_ENABLED=true
# 单聊每条消息最多回复条数。官方上限 4（群聊是 5，所以这两个值不能共用）。
QQ_C2C_MAX_REPLIES_PER_MSG=4
# 单聊进度回执条数上限，必须小于上面那一项（给最终答案留配额）。
QQ_C2C_PROGRESS_MAX=2

# --- 输出与行为（选填，留空用默认值）---------------------------------------
# 用 Markdown(msg_type=2) 还是纯文本(msg_type=0) 发消息（群聊与单聊共用）
QQ_MSG_TYPE=0
# 单条消息最大字符数。官方未公布数值上限，只在超限时报 40054007。
# 保守取 1500，遇到超限会自动折半重试。
QQ_MAX_CHARS=1500
# 群聊一次提问允许的最大回复条数（官方限制 5，留 1 条余量给错误提示）
QQ_MAX_REPLIES_PER_MSG=4
# 进度回执：turn 超过多少毫秒后发第一条「仍在处理中」
QQ_PROGRESS_AFTER_MS=90000
# 进度回执间隔与总条数上限（必须给最终答案留配额）
QQ_PROGRESS_INTERVAL_MS=90000
QQ_PROGRESS_MAX=3
# 单轮任务超时（毫秒），到点取消该轮（群聊与单聊共用）。
# 硬约束：必须 < 300000，因为群聊被动回复窗口只有 5 分钟，超时提示也要在这个窗口内发出。
# 单聊窗口更宽（官方文档为 60 分钟），这里故意沿用更保守的上限。
QQ_TURN_TIMEOUT_MS=240000

# --- DSH runtime ----------------------------------------------------------
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-flash

# --- 管理员白名单（可选）----------------------------------------------------
# 管理员身份键列表（逗号分隔），格式为 `平台:发送者id`，例如：
#   BOT_ADMINS=qq-official:ABCDEF123...,onebot:123456
# 平台前缀：官方是 qq-official（群聊 member_openid 与单聊 user_openid 是两个值），
# OneBot 是 onebot（QQ 号）。同一个人在不同平台/会话类型的身份键都不同，
# 都要管的话就都加进来。
# 管理员两个特权：
#   1. 永不被下面的谷时段闸拦截；
#   2. 可以用 /offpeak 命令热切换闸配置（下一条消息即生效，
#      且覆盖会持久化到 /data/bot/offpeak-override.json，重启后保留）。
# 发现自己的身份键：直接给机器人发 /offpeak whoami（对所有人开放）。
# 留空 = 没有管理员，/offpeak 的变更类子命令对所有人关闭（fail-closed）。
BOT_ADMINS=
# 兼容项（旧配置）：裸 openid 列表，自动按 qq-official 平台并入 BOT_ADMINS。
QQ_ADMIN_OPENIDS=

# --- DeepSeek 谷时段闸（可选）------------------------------------------------
# 开启后：当 <DSH_PROVIDER>/<DSH_MODEL> 命中 QQ_OFFPEAK_MODEL_PATTERN，且当前
# 不是谷时段时，直接回复提示、不调用 API（不写对话记录、不占并发名额）。
# 谷时段定义遵循 DeepSeek 官方《API 峰谷时间说明》（2026-09-19）：
#   工作日仅窗口内为谷；周六周日全天谷；中国法定节假日全天谷。
QQ_OFFPEAK_ENABLED=true
# 工作日谷时段窗口，一天可以有多个，用逗号分隔；每个窗口是 HH:MM-HH:MM，
# 区间为 [start, end)。默认北京时间 00:00-09:00、12:00-14:00、18:00-24:00
# （窗口之外 09:00-12:00、14:00-18:00 是正价时段）。
#   结束时间可写 24:00 表示当天结束；也支持跨零点（如 22:00-06:00）；
#   窗口之间不能重叠（重叠会在启动期报错）。
QQ_OFFPEAK_WINDOWS=00:00-09:00,12:00-14:00,18:00-24:00
# 兼容旧写法：只设 QQ_OFFPEAK_START / QQ_OFFPEAK_END 时按"单个窗口"处理，
# 且 QQ_OFFPEAK_WINDOWS 存在时以它为准。新部署建议只用上面那一个变量。
# QQ_OFFPEAK_START=00:30
# QQ_OFFPEAK_END=08:30
# 窗口所在时区（IANA 名称；容器内默认 UTC，不要依赖宿主时区）
QQ_OFFPEAK_TZ=Asia/Shanghai
# 命中判定：provider/model 组合串包含该子串（大小写不敏感）
QQ_OFFPEAK_MODEL_PATTERN=deepseek
# 周六、周日全天按谷价（2026-08-23 起官方规则；调休上班的周末仍是周六/日，
# 由本规则自动覆盖，无需额外配置）
QQ_OFFPEAK_WEEKENDS=true
# 法定节假日全天谷价：已内置 2026 年官方节假日（国办发明电〔2025〕7 号）。
# 跨年或临时日期在这里追加（逗号分隔 YYYY-MM-DD），或让管理员在 QQ 里用
# /offpeak holiday add 2027-01-01 热维护（覆盖持久化，重启不丢）。
QQ_OFFPEAK_HOLIDAYS=
# 全局并发 turn 上限（= 同时干活的会话数上限）
QQ_MAX_CONCURRENT_TURNS=4
# 并发 runtime 进程上限（LRU 回收）
QQ_MAX_RUNTIMES=8
# 空闲 runtime 回收时间（毫秒），回收后该会话下次提问会重建会话并回放历史
QQ_RUNTIME_IDLE_MS=1800000
# 冷启动回放的历史轮数
QQ_REPLAY_TURNS=12

# --- 健康检查 --------------------------------------------------------------
QQ_HEALTH_PORT=8080

# --- 出网代理（注意：不要写在这个文件里！）----------------------------------
# 让 DSH 能抓取网页正文需要设 HTTPS_PROXY / HTTP_PROXY，但这两个变量**必须**
# 写在 docker-compose.yml 的 environment 段，不能写在本文件：
#   dsh 启动器对「项目目录 .env 里的代理变量」有 fail-loud 守卫（防止仓库决定
#   流量去向），写在这里会导致 DSH 拒绝启动。
# 原因、端口说明与排查步骤见 docs/DEPLOY.md 第 9 节。
# 如需用户级默认值，写在容器内 /data/dsh/.env（= $DSH_HOME/.env）。
