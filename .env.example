# ============================================================================
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实密钥。
# ============================================================================

# --- QQ 机器人开放平台（必填）----------------------------------------------
# 获取位置：https://q.qq.com/qqbot/  → 开发设置
QQ_APP_ID=
QQ_APP_SECRET=

# --- DeepSeek（必填）-------------------------------------------------------
DEEPSEEK_API_KEY=

# --- QQ 事件接入 -----------------------------------------------------------
# 事件接收方式在 QQ 开放平台控制台切换（WebSocket ↔ Webhook），本 MVP 只实现
# WebSocket 长连接，控制台里请选择「WebSocket」。
QQ_API_BASE=https://api.bot.qq.com
# 订阅的 intents 位掩码。默认 = GROUP_AND_C2C_EVENT(1<<25) + GROUP_MEMBER_EVENT(1<<24)
# 如果连接被 4014（intent 无权限）拒绝，把这行改成 33554432 再试。
QQ_INTENTS=50331648

# --- 输出与行为（选填，留空用默认值）---------------------------------------
# 用 Markdown(msg_type=2) 还是纯文本(msg_type=0) 发消息
QQ_MSG_TYPE=0
# 单条消息最大字符数。官方未公布数值上限，只在超限时报 40054007。
# 保守取 1500，遇到超限会自动折半重试。
QQ_MAX_CHARS=1500
# 一次提问允许的最大回复条数（官方限制 5，留 1 条余量给错误提示）
QQ_MAX_REPLIES_PER_MSG=4
# 进度回执：turn 超过多少毫秒后发第一条「仍在处理中」
QQ_PROGRESS_AFTER_MS=90000
# 进度回执间隔与总条数上限（必须给最终答案留配额）
QQ_PROGRESS_INTERVAL_MS=90000
QQ_PROGRESS_MAX=3
# 单轮任务超时（毫秒），到点取消该轮。
# 硬约束：必须 < 300000，因为群被动回复窗口只有 5 分钟，超时提示也要在这个窗口内发出。
QQ_TURN_TIMEOUT_MS=240000

# --- DSH runtime ----------------------------------------------------------
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-flash
# 全局并发 turn 上限（= 同时干活的群数上限）
QQ_MAX_CONCURRENT_TURNS=4
# 并发 runtime 进程上限（LRU 回收）
QQ_MAX_RUNTIMES=8
# 空闲 runtime 回收时间（毫秒），回收后该群下次提问会重建会话并回放历史
QQ_RUNTIME_IDLE_MS=1800000
# 冷启动回放的历史轮数
QQ_REPLAY_TURNS=12

# --- 健康检查 --------------------------------------------------------------
QQ_HEALTH_PORT=8080
