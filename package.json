{
  "name": "qqbot-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "QQ 官方开放平台群聊/单聊机器人，agent 内核使用 DeepSeek Harness (DSH)，仅支持 Docker 部署",
  "type": "module",
  "engines": {
    "node": ">=22.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --experimental-strip-types --no-warnings src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "verify:sandbox": "node scripts/verify-sandbox.mjs",
    "test:integration": "BOT_TEST_INTEGRATION=1 vitest run tests/onebot.test.ts tests/forward.test.ts tests/files.test.ts",
    "prepare": "husky",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "sharp": "^0.35.3",
    "ws": "^8.21.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.8"
  }
}
