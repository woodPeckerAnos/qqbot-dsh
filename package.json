{
  "name": "qqbot-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "QQ 官方开放平台群聊/单聊机器人，agent 内核使用 DeepSeek Harness (DSH)，仅支持 Docker 部署",
  "type": "module",
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --experimental-strip-types --no-warnings src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify:sandbox": "node scripts/verify-sandbox.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
