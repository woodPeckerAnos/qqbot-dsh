{
  "name": "qqbot-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "QQ 官方开放平台群聊/单聊机器人，agent 内核使用 DeepSeek Harness (DSH)，仅支持 Docker 部署",
  "type": "module",
  "engines": {
    "node": ">=22.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "npm run contracts:build && tsc -p tsconfig.json",
    "typecheck": "npm run contracts:build && tsc -p tsconfig.json --noEmit && tsc -p tests/contracts/tsconfig.json && tsc -p tests/bench/tsconfig.json",
    "dev": "node --experimental-strip-types --no-warnings src/main.ts",
    "start": "node dist/main.js",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "bench:session": "npm run contracts:build && node scripts/session-benchmark.mjs",
    "bench:session:live": "npm run contracts:build && node scripts/session-benchmark.mjs --live",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run contracts:check && npm run lint && npm run format:check && npm test && node scripts/smoke-contracts.mjs && npm run check:docker-package",
    "verify:sandbox": "node scripts/verify-sandbox.mjs",
    "test:integration": "npm run build && BOT_TEST_INTEGRATION=1 vitest run tests/onebot.test.ts tests/forward.test.ts tests/files.test.ts",
    "prepare": "husky",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "contracts:build": "npm run build --workspace @qqbot/contracts",
    "contracts:generate": "npm run contracts:build && node scripts/generate-contracts.mjs",
    "contracts:check": "npm run contracts:build && node scripts/check-boundaries.mjs && node scripts/check-contract-compatibility.mjs && node scripts/check-contract-coverage.mjs && node scripts/generate-contracts.mjs --check",
    "smoke:contracts": "npm run build && node scripts/smoke-contracts.mjs",
    "check:docker-package": "node scripts/check-docker-package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "sharp": "^0.35.3",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "@qqbot/contracts": "1.0.0",
    "@deepseek-ai/dsh-llm-retry": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "packages/contracts"
  ]
}
